<article class="event-card">
    @if (!Editable)
    {
        <div class="event-card-topline">
            <span class="event-date">@Event.Date.ToString("dd MMM yyyy")</span>
            <span class="seat-count">@Event.AvailableSeats seats left</span>
        </div>
        <h2>@Event.Title</h2>
        <p class="event-location">@Event.Location</p>
        <p class="event-description">@Event.Description</p>
        <div class="event-card-footer">
            <span>@Event.AttendeeCount / @Event.Capacity registered</span>
            <div class="capacity-track" aria-label="Event capacity">
                <span style="width: @CapacityPercentage%"></span>
            </div>
        </div>
    }
    else
    {
        <div class="event-card-topline">
            <span class="eyebrow">Edit event details</span>
            <span class="event-date">@Event.Date.ToString("dd MMM yyyy")</span>
        </div>
        <EditForm Model="draft" OnValidSubmit="SaveChanges">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="field">
                <label for="event-title">Event title</label>
                <InputText id="event-title" class="input" @bind-Value="draft.Title" />
                <ValidationMessage For="@(() => draft.Title)" />
            </div>
            <div class="field">
                <label for="event-location">Location</label>
                <InputText id="event-location" class="input" @bind-Value="draft.Location" />
                <ValidationMessage For="@(() => draft.Location)" />
            </div>
            <div class="field">
                <label for="event-description">Description</label>
                <InputTextArea id="event-description" class="input textarea" @bind-Value="draft.Description" />
                <ValidationMessage For="@(() => draft.Description)" />
            </div>
            <div class="field">
                <label for="event-capacity">Capacity</label>
                <InputNumber id="event-capacity" class="input" @bind-Value="draft.Capacity" min="1" max="1000" />
                <ValidationMessage For="@(() => draft.Capacity)" />
            </div>
            <button class="button button-primary" type="submit">Save changes</button>
        </EditForm>
    }
</article>

@code {
    [Parameter]
    public EventItem Event { get; set; } = new();

    [Parameter]
    public EventCallback<EventItem> EventChanged { get; set; }

    [Parameter]
    public bool Editable { get; set; }

    [Inject]
    private EventService EventData { get; set; } = default!;

    private EventItem draft = new();

    private int CapacityPercentage => Event.Capacity <= 0
        ? 0
        : Math.Clamp((int)Math.Round((double)Event.AttendeeCount / Event.Capacity * 100), 0, 100);

    protected override void OnParametersSet()
    {
        draft = Event.Copy();
    }

    private async Task SaveChanges()
    {
        var updated = draft.Copy();
        if (EventData.UpdateEvent(updated))
        {
            await EventChanged.InvokeAsync(EventData.GetEventById(updated.Id)!);
        }
    }
}
